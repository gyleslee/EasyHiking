<Window x:Class="HikingGuide.App.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轨迹与标注点导入" Width="1080" Height="740" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16" Background="White">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="FileLabel" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
            <TextBlock Text="轨迹（一个项目只能设置一条攻略轨迹）" FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid x:Name="TrackGrid" AutoGenerateColumns="False" Height="125" CanUserAddRows="False" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="导入" Binding="{Binding Import, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                    <DataGridTemplateColumn Header="主攻略" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><RadioButton IsChecked="{Binding IsMain, Mode=OneWay}" Checked="MainTrackChecked"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="350" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="路线性质（有间隙时必选）" Width="185"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding RouteKinds}" SelectedItem="{Binding RouteKind, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasGap}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="轨迹段" Binding="{Binding SegmentCount}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="点数" Binding="{Binding PointCount}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="距离 km" Binding="{Binding DistanceKm}" Width="110" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,4,0,0">
                <Button Content="全选轨迹" Click="AllTracksClicked" Padding="8,3" Margin="0,0,6,0"/>
                <Button Content="反选轨迹" Click="InvertTracksClicked" Padding="8,3" Margin="0,0,6,0"/>
                <Button Content="不设置主攻略轨迹" Click="ClearMainTrackClicked" Padding="8,3"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
                <TextBlock Text="攻略轨迹：" VerticalAlignment="Center"/>
                <ComboBox x:Name="GuideTrackCombo" Width="390" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="GuideTrackChanged"/>
                <TextBlock x:Name="NoTrackHint" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="DarkOrange"/>
            </StackPanel>
            <TextBlock Text="标注点（默认只作为普通标注导入；勾选“攻略”后才参与分段）" FontWeight="Bold" Margin="0,0,0,4"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="AllGuideButton" Content="全选攻略" Click="AllGuideClicked" Margin="0,0,8,0" Padding="10,4"/>
                <Button x:Name="InvertGuideButton" Content="反选攻略" Click="InvertGuideClicked" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="全选导入" Click="AllImportClicked" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="反选导入" Click="InvertImportClicked" Margin="0,0,8,0" Padding="10,4"/>
                <Separator Width="15" Opacity="0"/>
                <Button Content="选中项设为攻略" Click="SelectedGuideClicked" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="选中项设为普通" Click="SelectedNormalClicked" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="选中项导入" Click="SelectedImportClicked" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="选中项不导入" Click="SelectedExcludeClicked" Margin="0,0,8,0" Padding="10,4"/>
                <ComboBox x:Name="BatchTypeCombo" Width="105" DisplayMemberPath="Name" SelectedValuePath="Code" Margin="0,0,6,0"/>
                <Button Content="设置选中项类型" Click="SelectedTypeClicked" Padding="10,4"/>
            </WrapPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Width="90" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="确认导入" Width="110" IsDefault="True" Click="ConfirmClicked"/>
                </StackPanel>
                <TextBlock x:Name="SummaryLabel" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Height="130">
            <TextBlock Text="图片预览（仅显示选中标注；网络图片导入后需主动下载）" FontWeight="Bold" Margin="0,0,0,5" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MediaPreviewPanel" Orientation="Horizontal" />
            </ScrollViewer>
        </StackPanel>
        <DataGrid x:Name="WaypointGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="WaypointSelectionChanged">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn x:Name="GuideColumn" Header="攻略" Binding="{Binding IsGuideNode, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                <DataGridCheckBoxColumn Header="导入" Binding="{Binding Import, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="250" IsReadOnly="True"/>
                <DataGridComboBoxColumn x:Name="OwnerTrackColumn" Header="归属轨迹" SelectedValueBinding="{Binding RelatedTrackId, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" SelectedValuePath="Id" Width="210"/>
                <DataGridComboBoxColumn x:Name="TypeColumn" Header="标注类型" SelectedValueBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" SelectedValuePath="Code" Width="130"/>
                <DataGridTextColumn Header="自定义类型名" Binding="{Binding CustomTypeName, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
                <DataGridTextColumn Header="图片" Binding="{Binding PictureSummary}" Width="125" IsReadOnly="True"/>
                <DataGridTextColumn Header="原始海拔 m" Binding="{Binding SourceElevation}" Width="105" IsReadOnly="True"/>
                <DataGridTextColumn Header="距轨迹 m（预览）" Binding="{Binding DistanceToTrack}" Width="135" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
