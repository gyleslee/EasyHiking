<Window x:Class="HikingGuide.App.BRouterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入BRouter路由数据" Width="760" Height="520"
        MinWidth="650" MinHeight="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="导入已有BRouter路由数据" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="可一次选择多个 .rd5 文件；先复制并校验，全部成功后才更新当前数据。源文件不会修改。"
                       Margin="0,7,0,10" TextWrapping="Wrap" />
        </StackPanel>
        <DataGrid x:Name="FileList" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="大小（MB）" Binding="{Binding SizeMb}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="135" IsReadOnly="True" />
                <DataGridTemplateColumn Header="同名处理" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <WrapPanel>
                <CheckBox x:Name="ApplyAll" Content="同名文件应用到所有" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="AllConflictChoice" Width="155" SelectedIndex="0">
                    <ComboBoxItem Content="保留当前文件" />
                    <ComboBoxItem Content="使用导入文件替换" />
                </ComboBox>
            </WrapPanel>
            <TextBlock x:Name="SummaryText" Margin="0,6,0,0" />
            <TextBlock x:Name="ProgressText" Margin="0,5,0,0" Text="准备导入" TextWrapping="Wrap" />
            <ProgressBar x:Name="ImportProgress" Height="11" Margin="0,5,0,0" Minimum="0" Maximum="1" />
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="重新选择文件…" Click="OnReselect" Padding="10,5" Margin="0,0,6,0" />
            <Button x:Name="ImportButton" Content="开始导入" Click="OnImport" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="关闭 / 取消" Click="OnCancel" Padding="10,5" />
        </WrapPanel>
    </Grid>
</Window>
