<Window x:Class="HikingGuide.App.ProjectItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑项目内容" Width="500" Height="515" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="保存修改" Width="92" Margin="0,0,8,0" IsDefault="True" Click="OnSave" />
            <Button Content="取消" Width="72" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="ObjectKindText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="名称" FontWeight="SemiBold" />
                <TextBox x:Name="NameInput" Margin="0,4,0,4" MaxLength="200" />
                <TextBlock x:Name="NameHint" Foreground="#666666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="说明 / 攻略描述" FontWeight="SemiBold" />
                <TextBox x:Name="DescriptionInput" Margin="0,4,0,12" Height="120"
                         MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <StackPanel x:Name="RoadConditionPanel" Visibility="Collapsed">
                    <TextBlock Text="路况" FontWeight="SemiBold" />
                    <TextBox x:Name="RoadConditionInput" Margin="0,4,0,12" MaxLength="1000" />
                </StackPanel>
                <StackPanel x:Name="DurationPanel" Visibility="Collapsed">
                    <TextBlock Text="计划用时（分钟，可留空）" FontWeight="SemiBold" />
                    <TextBox x:Name="DurationInput" Margin="0,4,0,12" />
                </StackPanel>
                <StackPanel x:Name="ColorPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="轨迹颜色" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border x:Name="ColorPreview" Width="28" Height="20" BorderBrush="#666666"
                            BorderThickness="1" Margin="0,0,10,0" />
                    <Button Content="选择颜色…" Padding="10,3" Click="OnPickColor" />
                </StackPanel>
                <TextBlock x:Name="SafetyHint" Foreground="#666666" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
