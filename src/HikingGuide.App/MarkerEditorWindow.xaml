<Window x:Class="HikingGuide.App.MarkerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑标注与攻略节点" Width="480" Height="460" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="确定" Width="90" IsDefault="True" Click="ConfirmClicked"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="名称" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10"/>
            <TextBlock Text="描述" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="标注类型" Margin="0,0,0,4"/>
            <ComboBox x:Name="TypeCombo" DisplayMemberPath="Name" SelectedValuePath="Code" Margin="0,0,0,10"/>
            <TextBlock Text="自定义类型名称（仅类型为“自定义”时使用）" Margin="0,0,0,4"/>
            <TextBox x:Name="CustomTypeBox" Margin="0,0,0,10"/>
            <CheckBox x:Name="GuideCheck" Content="设为攻略节点（参与排序与分段）" Margin="0,0,0,10" Checked="GuideChecked" Unchecked="GuideChecked"/>
            <TextBlock Text="普通标注所属轨迹（攻略节点固定使用主攻略轨迹）" Margin="0,0,0,4"/>
            <ComboBox x:Name="TrackCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,8"/>
            <TextBlock x:Name="CoordinateLabel" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
