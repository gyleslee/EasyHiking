<Window x:Class="HikingGuide.App.MapSourceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:HikingGuide.App"
        Title="地图管理" Background="#F8FAFC" Width="1080" Height="760" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12" Background="#F8FAFC">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Text="当前地图图层为软件全局设置，切换项目不会改变。设置不写入项目文件；请求令牌等敏感内容会以明文保存，请仅在可信电脑使用。"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="关闭" Width="88" Margin="4" IsDefault="True" Click="OnSave"/></StackPanel>
        <GroupBox Header="当前地图图层（软件全局，实时更新并自动保存）" DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                <TextBlock Text="底图：" VerticalAlignment="Center"/><ComboBox x:Name="BaseBox" Grid.Column="1" Margin="0,4,8,4" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OnSlotChanged"/><TextBlock Grid.Column="2" Text="始终显示" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="透明度：" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal"><Slider x:Name="BaseOpacity" Width="160" Minimum="0" Maximum="100" ValueChanged="OnOpacityChanged" LostKeyboardFocus="OnOpacityCommit" VerticalAlignment="Center"/><TextBlock Text="{Binding ElementName=BaseOpacity,Path=Value,StringFormat={}{0:F0}%}" Width="55" VerticalAlignment="Center" TextAlignment="Right"/></StackPanel>
                <TextBlock Grid.Row="1" Text="叠加层1：" VerticalAlignment="Center"/><ComboBox x:Name="Overlay1Box" Grid.Row="1" Grid.Column="1" Margin="0,4,8,4" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OnSlotChanged"/><CheckBox x:Name="Overlay1Visible" Grid.Row="1" Grid.Column="2" Content="显示" VerticalAlignment="Center" Click="OnSlotChanged"/><TextBlock Grid.Row="1" Grid.Column="3" Text="透明度：" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal"><Slider x:Name="Overlay1Opacity" Width="160" Minimum="0" Maximum="100" ValueChanged="OnOpacityChanged" LostKeyboardFocus="OnOpacityCommit" VerticalAlignment="Center"/><TextBlock Text="{Binding ElementName=Overlay1Opacity,Path=Value,StringFormat={}{0:F0}%}" Width="55" VerticalAlignment="Center" TextAlignment="Right"/></StackPanel>
                <TextBlock Grid.Row="2" Text="叠加层2：" VerticalAlignment="Center"/><ComboBox x:Name="Overlay2Box" Grid.Row="2" Grid.Column="1" Margin="0,4,8,4" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OnSlotChanged"/><CheckBox x:Name="Overlay2Visible" Grid.Row="2" Grid.Column="2" Content="显示" VerticalAlignment="Center" Click="OnSlotChanged"/><TextBlock Grid.Row="2" Grid.Column="3" Text="透明度：" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal"><Slider x:Name="Overlay2Opacity" Width="160" Minimum="0" Maximum="100" ValueChanged="OnOpacityChanged" LostKeyboardFocus="OnOpacityCommit" VerticalAlignment="Center"/><TextBlock Text="{Binding ElementName=Overlay2Opacity,Path=Value,StringFormat={}{0:F0}%}" Width="55" VerticalAlignment="Center" TextAlignment="Right"/></StackPanel>
            </Grid>
        </GroupBox>
        <TabControl x:Name="LibraryTabs"><TabItem Header="在线图源库"><GroupBox Header="图源库"><DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="新增" Width="90" Margin="0,0,6,0" Click="OnAdd"/><Button Content="编辑" Width="90" Margin="0,0,6,0" Click="OnEdit"/><Button Content="删除" Width="90" Margin="0,0,6,0" Click="OnDelete"/><Button Content="启用 / 禁用" Width="110" Margin="0,0,6,0" Click="OnToggleEnabled"/><Button x:Name="TestButton" Content="测试各服务器" Width="130" Click="OnTest"/><Button x:Name="ClearOnlineCacheButton" Content="清空缓存" Width="100" Margin="6,0,0,0" IsEnabled="False" Click="OnClearOnlineCache" ToolTip="只清空下方选中图源的本地瓦片缓存，不删除图源设置。"/></StackPanel>
            <TextBox x:Name="TestResults" DockPanel.Dock="Bottom" Height="110" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="支持 {z}/{zoom}/{x}/{y}、{$s}（Google mt：0～3；其他图源：01～04）或一个 {switch:a,b,c} 表达式。编辑图源可设置坐标系，GCJ-02/BD-09标准XYZ瓦片自动纠偏。图源库修改确认后自动保存。"/>
            <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="OnGridDoubleClick" SelectionChanged="OnSourceSelectionChanged"><DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="坐标系" Binding="{Binding CoordinateSystemText}" Width="160"/><DataGridTextColumn Header="可用位置" Binding="{Binding UsageText}" Width="120"/><DataGridTextColumn Header="缓存容量MB" Binding="{Binding CacheCapacityMb}" Width="95"/><DataGridTextColumn Header="网址模板" Binding="{Binding UrlTemplate}" Width="*"/><DataGridTextColumn Header="最小缩放" Binding="{Binding MinZoom}" Width="65"/><DataGridTextColumn Header="最大缩放" Binding="{Binding MaxZoom}" Width="65"/>
            </DataGrid.Columns></DataGrid>
        </DockPanel></GroupBox></TabItem>
        <TabItem Header="等高线生成器"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
            <TextBlock Text="DEM派生等高线（独立叠加，不占用在线图源位置）" FontSize="16" FontWeight="Bold"/>
            <TextBlock Margin="0,8" TextWrapping="Wrap" Text="只生成当前地图请求区域，后台处理并保留缓存；不写入DEM原文件，也不改变攻略高程来源。缓存为透明PNG瓦片的原子缓存包（.tile），达到上限后自动删除最早生成的缓存。"/>
            <StackPanel Orientation="Horizontal" Margin="0,6"><TextBlock Text="生成DEM：" Width="100" VerticalAlignment="Center"/><ComboBox x:Name="TerrainDem" Width="440" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8"><CheckBox x:Name="TerrainContours" Content="显示等高线" Width="130"/><TextBlock Text="颜色："/><Button x:Name="TerrainColor" Content="#8B5A2B" Width="110" Click="OnTerrainColor" Margin="8,0"/><TextBlock Text="透明度：" VerticalAlignment="Center" Margin="12,0,0,0"/><Slider x:Name="TerrainContourOpacity" Width="180" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="0%=完全透明，100%=完全显示；主等高线与海拔数字同步变化，2D/3D共用。"/><TextBlock Text="{Binding ElementName=TerrainContourOpacity,Path=Value,StringFormat={}{0:F0}%}" Width="55" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8"><CheckBox x:Name="TerrainMajorContours" Content="加粗主等高线" Width="150"/><TextBlock Text="主等高线间隔：" VerticalAlignment="Center"/><TextBox x:Name="TerrainMajorInterval" Text="50" Width="90" Margin="8,0" VerticalContentAlignment="Center"/><TextBlock Text="米（按该值的倍数加粗）" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Text="默认50米倍数为主等高线，线宽为普通线的2倍；2D与3D共用设置，粗细线一同贴合3D地形。此项不改变等高距；Z13—Z14的100米线在默认规则下均为主等高线。" TextWrapping="Wrap"/>
            <TextBlock Text="Z13—Z14：100米等高距；Z15及以上：10米等高距；显示海拔数字，不生成0米等高线。" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8"><TextBlock Text="等高线缓存：" Width="130"/><TextBox x:Name="TerrainContourCache" Width="100"/><TextBlock Text=" MB（默认2048；0为不保留）"/><Button x:Name="ClearContoursButton" Content="清除等高线缓存" Margin="12,0,0,0" Padding="10,4" Click="OnClearContours"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8"><CheckBox x:Name="TerrainHillshade" Content="显示地形阴影" Width="150"/><TextBlock Text="叠加强度："/><Slider x:Name="TerrainOpacity" Width="180" Minimum="0" Maximum="100" Value="30" ToolTip="仅控制背光部分的加深程度；平坦和受光区域不覆盖底图。0%不叠加，100%使用完整暗部强度。"/><TextBlock Text="{Binding ElementName=TerrainOpacity,Path=Value,StringFormat={}{0:F0}%}" Width="55"/></StackPanel>
            <TextBlock Text="阴影与等高线使用同一DEM，从Z13显示。平坦和受光区域透明，背光区域自然渐变；光照方位315°、高度45°。地图放大不提升DEM原始精度。" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8"><TextBlock Text="地形阴影缓存：" Width="130"/><TextBox x:Name="TerrainShadeCache" Width="100"/><TextBlock Text=" MB（默认1024；0为不保留）"/><Button x:Name="ClearShadeButton" Content="清除阴影缓存" Margin="12,0,0,0" Padding="10,4" Click="OnClearShade"/></StackPanel>
            <Button Content="应用并保存等高线生成设置" HorizontalAlignment="Left" Padding="16,6" Margin="0,12" Click="OnApplyTerrain"/>
            <TextBlock x:Name="TerrainStatus" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer></TabItem><TabItem Header="OSM路网"><local:OsmRoadSettingsPanel x:Name="RoadPanel"/></TabItem><TabItem Header="下载离线地图"><local:OfflineMapDownloadPanel x:Name="OfflinePanel"/></TabItem></TabControl>
    </DockPanel>
</Window>




