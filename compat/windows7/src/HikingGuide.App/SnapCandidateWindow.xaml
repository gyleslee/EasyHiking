<Window x:Class="HikingGuide.App.SnapCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择轨迹吸附位置" Width="610" Height="380" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="以下候选基于完整原始轨迹线段。请选择与节点实际位置对应的线段。" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Width="85" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="使用所选位置" Width="120" IsDefault="True" Click="ConfirmClicked"/>
        </StackPanel>
        <DataGrid x:Name="CandidateGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="候选" Binding="{Binding Order}" Width="60"/>
                <DataGridTextColumn Header="距点击处 m" Binding="{Binding DistanceToClick}" Width="110"/>
                <DataGridTextColumn Header="轨迹累计 km" Binding="{Binding DistanceKm}" Width="120"/>
                <DataGridTextColumn Header="轨迹段" Binding="{Binding SegmentIndex}" Width="85"/>
                <DataGridTextColumn Header="线段起点索引" Binding="{Binding PointIndex}" Width="110"/>
                <DataGridTextColumn Header="线段比例" Binding="{Binding Fraction}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
