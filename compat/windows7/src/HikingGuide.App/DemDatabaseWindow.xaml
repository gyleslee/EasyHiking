<Window x:Class="HikingGuide.App.DemDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DEM 高程数据库管理" Width="900" Height="550" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="DEM 只按路径挂载；扫描索引保存在软件数据目录，不复制、修改或删除原始 TIF/HGT。"
                   TextWrapping="Wrap" Margin="0,0,0,9" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,8,0,0">
            <ProgressBar x:Name="ScanProgress" Height="7" Visibility="Collapsed" IsIndeterminate="True" />
            <TextBlock x:Name="StatusLabel" Text="请选择数据库，或挂载一个包含 TIF/HGT 的目录。" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="挂载目录…" Click="OnMount" Margin="0,0,6,0" Padding="12,5" />
            <Button Content="重新扫描" Click="OnRescan" Margin="0,0,6,0" Padding="12,5" />
            <Button Content="重新定位…" Click="OnRelocate" Margin="0,0,6,0" Padding="12,5" />
            <Button Content="重命名…" Click="OnRename" Margin="0,0,6,0" Padding="12,5" />
            <Button Content="移除挂载" Click="OnRemove" Margin="0,0,6,0" Padding="12,5" />
            <Button Content="刷新状态" Click="OnRefresh" Padding="12,5" />
        </StackPanel>
        <DataGrid x:Name="DatabaseGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="数据库名称" Binding="{Binding Name}" Width="145" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="95" />
                <DataGridTextColumn Header="目录路径" Binding="{Binding RootPath}" Width="*" />
                <DataGridTextColumn Header="有效文件" Binding="{Binding ValidFileCount}" Width="75" />
                <DataGridTextColumn Header="无效文件" Binding="{Binding InvalidFileCount}" Width="75" />
                <DataGridTextColumn Header="单位" Binding="{Binding UnitText}" Width="75" />
                <DataGridTextColumn Header="垂直基准" Binding="{Binding VerticalDatumName}" Width="95" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
