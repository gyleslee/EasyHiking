<Window x:Class="HikingGuide.App.MergedExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="合并导出" Width="890" Height="690" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="格式：" VerticalAlignment="Center" />
                <ComboBox x:Name="FormatBox" Width="150" SelectedIndex="2">
                    <ComboBoxItem Content="GPX" />
                    <ComboBoxItem Content="KML" />
                    <ComboBoxItem Content="KMZ" />
                </ComboBox>
            </StackPanel>
            <TextBlock Text="轨迹" FontWeight="Bold" Margin="0,0,0,4" />
            <DataGrid x:Name="TrackGrid" AutoGenerateColumns="False" Height="150" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="导出" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="轨迹段" Binding="{Binding SegmentCount}" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn Header="轨迹点" Binding="{Binding PointCount}" IsReadOnly="True" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,12">
                <Button Content="全选轨迹" Click="SelectAllTracks" Padding="8,3" Margin="0,0,8,0" />
                <Button Content="反选轨迹" Click="InvertTracks" Padding="8,3" />
            </StackPanel>
            <TextBlock Text="标注（普通标注与攻略节点）" FontWeight="Bold" Margin="0,0,0,4" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="全选标注" Click="SelectAllMarkers" Padding="8,3" Margin="0,0,8,0" />
                <Button Content="反选标注" Click="InvertMarkers" Padding="8,3" />
            </StackPanel>
            <DockPanel>
                <TextBlock Text="GPX/KML 不携带项目图片原图；KMZ 会打包所选标注的项目图片。网络图片不会自动下载。"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" IsCancel="True" Width="88" Margin="0,0,8,0" />
                    <Button Content="选择文件并导出" Click="ConfirmClicked" IsDefault="True" Width="130" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <DataGrid x:Name="MarkerGrid" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="导出" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" IsReadOnly="True" Width="95" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="身份" Binding="{Binding Identity}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="所属轨迹" Binding="{Binding TrackName}" IsReadOnly="True" Width="135" />
                <DataGridTextColumn Header="项目图片" Binding="{Binding InternalCount}" IsReadOnly="True" Width="75" />
                <DataGridTextColumn Header="网络图片" Binding="{Binding ExternalCount}" IsReadOnly="True" Width="75" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
