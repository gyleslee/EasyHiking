<Window x:Class="HikingGuide.App.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建徒步攻略项目" Width="580" Height="235"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="项目名称：" VerticalAlignment="Center"/>
        <TextBox x:Name="ProjectNameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="项目保存位置：" VerticalAlignment="Center"/>
        <TextBox x:Name="LocationBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"/>
        <Button Grid.Row="1" Grid.Column="2" Content="浏览" Width="72" Click="Browse_Click"/>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="创建" Width="88" IsDefault="True" Click="Create_Click"/>
            <Button Content="取消" Width="88" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
