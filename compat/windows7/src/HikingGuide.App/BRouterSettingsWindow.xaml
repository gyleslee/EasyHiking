<Window x:Class="HikingGuide.App.BRouterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BRouter路由数据" Width="760" Height="580"
        MinWidth="650" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="BRouter路由数据管理" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="EngineStatus" Margin="0,6,0,3" TextWrapping="Wrap" />
            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" />
            <TextBlock x:Name="CurrentData" Margin="0,3,0,9" TextWrapping="Wrap" />
        </StackPanel>
        <GroupBox Grid.Row="1" Header="获取路由数据" Margin="0,0,0,9">
            <StackPanel Margin="10,7">
                <WrapPanel>
                    <Button x:Name="UpdateChinaButton" Content="下载中国范围路由数据" Click="OnUpdateChina" Padding="11,6" Margin="0,0,8,0" />
                    <Button x:Name="SelectWorldButton" Content="手动选择世界路由数据…" Click="OnSelectWorld" Padding="11,6" Margin="0,0,8,0" />
                    <Button x:Name="ImportButton" Content="导入已有BRouter路由数据…" Click="OnImport" Padding="11,6" />
                </WrapPanel>
                <TextBlock x:Name="ChinaManifest" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>
        <TextBlock Grid.Row="2" Text="当前路由数据（建议使用导入功能添加文件，直接复制不会自动更新清单）" Margin="0,0,0,5" />
        <DataGrid x:Name="InstalledTiles" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="瓦片" Binding="{Binding FileName}" Width="*" />
                <DataGridTextColumn Header="大小（MB）" Binding="{Binding SizeMb}" Width="120" />
                <DataGridTextColumn Header="来源" Binding="{Binding SourceLabel}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,9,0,9">
            <TextBlock x:Name="ProgressText" Text="就绪" TextWrapping="Wrap" />
            <ProgressBar x:Name="DownloadProgress" Height="12" Margin="0,6,0,0" Minimum="0" Maximum="1" />
        </StackPanel>
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
            <Button Content="打开路由数据目录" Click="OnOpenDirectory" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="取消当前操作" Click="OnCancelDownload" Padding="10,5" />
        </WrapPanel>
    </Grid>
</Window>
