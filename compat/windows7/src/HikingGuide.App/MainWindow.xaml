<Window x:Class="HikingGuide.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HikingGuide.App.ViewModels"
        xmlns:local="clr-namespace:HikingGuide.App"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/AppLogo.png"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        PreviewKeyDown="OnPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
        <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <local:SixCharacterWidthConverter x:Key="SixCharacterWidth" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <HierarchicalDataTemplate DataType="{x:Type vm:NavigationNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsMapVisible, Mode=TwoWay}"
                          Visibility="{Binding CanToggleMapVisibility, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ToolTip="在地图上显示或隐藏此轨迹或攻略分段"
                          VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap"
                       ToolTip="{Binding DisplayName}"
                       PreviewMouseRightButtonDown="OnNavigationRightClick"
                       MouseLeftButtonDown="OnNavigationTextClick"
                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActiveProject}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Background" Value="#D8EBFF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                <Setter Property="Background" Value="#A8D8FF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="编辑名称与属性…"
                                  Visibility="{Binding PlacementTarget.DataContext.IsEditableGeometry, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.EditProjectGeometryItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="设为当前工作轨迹"
                                  Command="{Binding PlacementTarget.Tag.SetActiveTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="设为主攻略轨迹"
                                  Command="{Binding PlacementTarget.Tag.SetMainGuideTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="转为普通轨迹（攻略节点同步转为普通标注）"
                                  Command="{Binding PlacementTarget.Tag.ClearMainGuideTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="关闭项目"
                                  Visibility="{Binding PlacementTarget.DataContext.IsProject, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.CloseProjectContextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="删除轨迹"
                                  Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="设置轨迹颜色…"
                                  Command="{Binding PlacementTarget.Tag.SetTrackColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="进入轨迹编辑模式"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrack, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.EnterTrackEditContextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="退出轨迹编辑模式"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrack, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.ExitTrackEditContextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="定位轨迹段"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackSegment, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.FocusTrackSegmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="反转轨迹段"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackSegment, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.ReverseTrackSegmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="删除轨迹段"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackSegment, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.DeleteTrackSegmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="添加轨迹点"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackOrSplitSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.AddTrackPointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="删除轨迹点"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackOrSplitSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.DeleteTrackPointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="拆分轨迹段"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackOrSplitSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.SplitTrackSegmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="反转整条轨迹"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackOrSplitSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.ReverseTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="合并轨迹"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackOrSplitSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.CreateMergedTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="连接轨迹"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackOrSplitSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.CreateConnectedTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="批量显示所选轨迹" Command="{Binding PlacementTarget.Tag.ShowSelectedTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="批量隐藏所选轨迹" Command="{Binding PlacementTarget.Tag.HideSelectedTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="为所选轨迹重新分配不同颜色" Command="{Binding PlacementTarget.Tag.RecolorSelectedTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="批量关联所选普通标注到当前工作轨迹" Command="{Binding PlacementTarget.Tag.AssociateSelectedWaypointsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="批量编辑标注或攻略节点" Command="{Binding PlacementTarget.Tag.BatchEditMarkersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="选择吸附路段（重合／折返）…" Command="{Binding PlacementTarget.Tag.ChooseSnapBranchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedMarker, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="批量修改为攻略节点" Command="{Binding PlacementTarget.Tag.ConvertSelectedWaypointsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="批量修改为普通节点" Command="{Binding PlacementTarget.Tag.ConvertSelectedGuideNodesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="批量删除所选轨迹或标注" Command="{Binding PlacementTarget.Tag.DeleteSelectedProjectItemsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="导出GPX"
                                  Command="{Binding PlacementTarget.Tag.ExportTrackGpxCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="导出KML"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackOrSplitSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.ExportTrackKmlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="导出KMZ"
                                  Visibility="{Binding PlacementTarget.DataContext.IsTrackOrSplitSection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Command="{Binding PlacementTarget.Tag.ExportTrackKmzCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="查看属性"
                                  Command="{Binding PlacementTarget.Tag.ViewTrackPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="编辑标注或攻略节点"
                                  Command="{Binding PlacementTarget.Tag.EditMarkerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="删除标注或攻略节点"
                                  Command="{Binding PlacementTarget.Tag.DeleteMarkerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="在地图上选择攻略节点吸附位置"
                                  Command="{Binding PlacementTarget.Tag.PickGuidePositionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="复制为收藏点" Click="OnCopyFavorite"
                                  Visibility="{Binding PlacementTarget.DataContext.IsMarker, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
            <Border Width="12" Height="12" Margin="5,0,0,0" VerticalAlignment="Center"
                    BorderBrush="#666666" BorderThickness="1" Background="{Binding TrackColor}"
                    Visibility="{Binding IsTrack, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowPanels">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="UpperPanelRow" Height="*" MinHeight="120" />
            <RowDefinition x:Name="UpperBottomSplitterRow" Height="6" />
            <RowDefinition x:Name="BottomPanelRow" Height="300" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="文件">
                <MenuItem Header="新建项目" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="打开项目" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="保存项目" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="项目另存为" Command="{Binding SaveProjectAsCommand}" />
                <MenuItem Header="关闭项目" Command="{Binding CloseProjectCommand}" />
                <MenuItem Header="最近打开的项目" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding ProjectName}" />
                            <Setter Property="ToolTip" Value="{Binding FilePath}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="导入GPX、KML、KMZ…" Command="{Binding ImportUnifiedCommand}" />
                <Separator />
                <MenuItem Header="导出GPX" Command="{Binding ExportGpxCommand}" />
                <MenuItem Header="导出KML" Command="{Binding ExportKmlCommand}" />
                <MenuItem Header="导出KMZ" Command="{Binding ExportKmzCommand}" />
                <MenuItem Header="合并导出…" Command="{Binding MergedExportCommand}" />
                <Separator />
                <MenuItem Header="退出" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="编辑">
                <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="重做" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
            </MenuItem>
            <MenuItem Header="轨迹编辑">
                <MenuItem Header="进入轨迹编辑模式" Command="{Binding EnterTrackEditCommand}" />
                <MenuItem Header="退出轨迹编辑模式" Command="{Binding ExitTrackEditCommand}" />
                <Separator />
                <MenuItem Header="添加轨迹点" Command="{Binding AddTrackPointCommand}" />
                <MenuItem Header="删除轨迹点" Command="{Binding DeleteTrackPointCommand}" />
                <Separator />
                <MenuItem Header="拆分轨迹段" Command="{Binding SplitTrackSegmentCommand}" />
                <MenuItem Header="删除轨迹段" Command="{Binding DeleteTrackSegmentCommand}" />
                <MenuItem Header="反转轨迹段" Command="{Binding ReverseTrackSegmentCommand}" />
                <Separator />
                <MenuItem Header="反转整条轨迹" Command="{Binding ReverseTrackCommand}" />
                <Separator />
                <Separator />
                <MenuItem Header="合并轨迹" Command="{Binding CreateMergedTrackCommand}" />
                <MenuItem Header="连接轨迹" Command="{Binding CreateConnectedTrackCommand}" />
            </MenuItem>
            <MenuItem Header="路线规划">
                <MenuItem Header="BRouter路由规划模式" Command="{Binding StartBRouterPlanCommand}" />
                <MenuItem Header="手绘规划模式" Command="{Binding StartManualPlanCommand}" />
                <MenuItem Header="混合规划模式" Command="{Binding StartMixedPlanCommand}" />
                <Separator />
                <MenuItem Header="BRouter设置与路由数据…" Click="OnOpenBRouterSettings" />
            </MenuItem>
            <MenuItem Header="标注点">
                <MenuItem Header="添加攻略节点" Command="{Binding AddGuideMenuCommand}" />
                <MenuItem Header="添加普通标注" Command="{Binding AddWaypointMenuCommand}" />
                <Separator />
                <MenuItem Header="编辑标注" Command="{Binding EditSelectedMenuCommand}" />
                <MenuItem Header="删除标注" Command="{Binding DeleteSelectedMenuCommand}" />
                <MenuItem Header="转为攻略节点" Command="{Binding ConvertToGuideMenuCommand}" />
                <MenuItem Header="转为普通标注" Command="{Binding ConvertToWaypointMenuCommand}" />
                <MenuItem Header="设置标注类型" Command="{Binding EditSelectedMenuCommand}" />
                <Separator />
                <MenuItem Header="重新吸附到轨迹" Command="{Binding ResnapSelectedMenuCommand}" />
                <MenuItem Header="选择轨迹位置" Command="{Binding PickSelectedMenuCommand}" />
                <MenuItem Header="关联到轨迹…" Command="{Binding AssociateCurrentTrackMenuCommand}" />
                <MenuItem Header="检查所有攻略节点" Command="{Binding CheckGuidesMenuCommand}" />
                <MenuItem Header="重新计算主攻略轨迹节点" Command="{Binding ResnapActiveGuidesCommand}" />
            </MenuItem>
            <MenuItem Header="地图">
                <MenuItem Header="在线图源" ItemsSource="{Binding Map.MapSources}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Command" Value="{Binding DataContext.Map.SelectMapSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="地图管理" Click="OnManageMapSources" />
                <MenuItem Header="3D地图…" Click="OnTerrain3DSettings" />
                <MenuItem Header="重新加载地图" Command="{Binding Map.ReloadCommand}" />
                <Separator />
                <MenuItem Header="适应当前轨迹" Command="{Binding Map.FitCurrentTrackCommand}" />
                <MenuItem Header="适应全部轨迹" Command="{Binding Map.FitAllCommand}" />
            </MenuItem>
            <MenuItem Header="分析">
                <MenuItem Header="打开数据分析面板" Click="OnOpenElevationAnalysis" />
            </MenuItem>
            <MenuItem Header="导出" IsEnabled="False" />
            <MenuItem Header="收藏点">
                <MenuItem Header="打开收藏点面板" Click="OnOpenFavorites" />
                <MenuItem Header="新建收藏点…" Click="OnNewFavorite" />
                <Separator />
                <MenuItem Header="新建收藏夹…" Click="OnCreateFavoriteCollection" />
                <MenuItem Header="重命名收藏夹…" Click="OnRenameFavoriteCollection" />
                <MenuItem Header="删除收藏夹…" Click="OnDeleteFavoriteCollection" />
                <Separator />
                <MenuItem Header="收藏点管理器…" Click="OnFavoriteManager" />
                <MenuItem Header="导入收藏点…" Click="OnImportFavorites" />
                <MenuItem Header="导出收藏点…" Click="OnExportFavorites" />
                <MenuItem Header="导出为KMZ…" Click="OnExportFavoritesKmz" />
                <Separator />
                <MenuItem x:Name="FavoritesVisibleMenu" Header="地图上显示收藏点" IsCheckable="True" Click="OnFavoriteVisibility" />
            </MenuItem>
            <MenuItem Header="设置">
                <MenuItem Header="DEM与路由数据设置向导…" Click="OnOpenFirstRunSetup" />
                <MenuItem Header="DEM 高程数据库…" Click="OnOpenDemDatabases" />
                <MenuItem Header="面板显示">
                    <MenuItem x:Name="ProjectPanelMenu" Header="项目与节点" Tag="Project" IsCheckable="True" StaysOpenOnClick="True" Click="OnPanelVisibilityClick" />
                    <MenuItem x:Name="MapPanelMenu" Header="地图" Tag="Map" IsCheckable="True" StaysOpenOnClick="True" Click="OnPanelVisibilityClick" />
                    <MenuItem x:Name="PropertiesPanelMenu" Header="属性" Tag="Properties" IsCheckable="True" StaysOpenOnClick="True" Click="OnPanelVisibilityClick" />
                    <Separator />
                    <MenuItem x:Name="GuidePanelMenu" Header="攻略数据" Tag="Guide" IsCheckable="True" StaysOpenOnClick="True" Click="OnPanelVisibilityClick" />
                    <MenuItem x:Name="PlanningPanelMenu" Header="路线规划" Tag="Planning" IsCheckable="True" StaysOpenOnClick="True" Click="OnPanelVisibilityClick" />
                    <MenuItem x:Name="AnalysisPanelMenu" Header="数据分析" Tag="Analysis" IsCheckable="True" StaysOpenOnClick="True" Click="OnPanelVisibilityClick" />
                    <MenuItem x:Name="FavoritesPanelMenu" Header="收藏点" Tag="Favorites" IsCheckable="True" StaysOpenOnClick="True" Click="OnPanelVisibilityClick" />
                    <MenuItem x:Name="StatusPanelMenu" Header="状态栏" Tag="Status" IsCheckable="True" StaysOpenOnClick="True" Click="OnPanelVisibilityClick" />
                    <Separator />
                    <MenuItem Header="恢复默认面板布局" Click="OnResetPanelLayout" ToolTip="重新显示全部面板并恢复默认面板大小；不改变表格列宽或项目数据。" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="操作说明" Click="OnOpenManual" />
                <Separator />
                <MenuItem Header="关于易行徒步规划制作器" Click="OnOpenAbout" />
            </MenuItem>
        </Menu>

        <Grid x:Name="UpperPanels" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProjectPanelColumn" Width="280" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="MapPanelColumn" Width="*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="PropertiesPanelColumn" Width="300" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="ProjectPanel" Grid.Column="0" Header="项目与节点" Margin="6">
                <GroupBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新建项目" Command="{Binding PlacementTarget.DataContext.NewProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="打开项目" Command="{Binding PlacementTarget.DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </GroupBox.ContextMenu>
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="当前项目" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectName}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0" Foreground="#555555" FontSize="11"
                                   ToolTip="项目、分组及所有条目均可多选；批量操作只处理适用的对象类型和当前项目。">
                            <Run Text="所有条目可 Ctrl / Shift 多选；已选 " /><Run Text="{Binding SelectedProjectItemCount, Mode=OneWay}" /><Run Text=" 项" />
                        </TextBlock>
                    </StackPanel>
                    <TreeView x:Name="ProjectTree" ItemsSource="{Binding NavigationNodes}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="OnNavigationLeftClick"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              SelectedItemChanged="OnNavigationSelectionChanged" />
                </DockPanel>
            </GroupBox>

            <GridSplitter x:Name="ProjectPanelSplitter" Grid.Column="1" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnPanelSplitterDragCompleted" />

            <Border x:Name="MapPanel" Grid.Column="2" Margin="6" BorderBrush="#B8B8B8" BorderThickness="1">
                <local:MapView DataContext="{Binding Map}" />
            </Border>

            <GridSplitter x:Name="PropertiesPanelSplitter" Grid.Column="3" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnPanelSplitterDragCompleted" />

            <GroupBox x:Name="PropertiesPanel" Grid.Column="4" Header="属性" Margin="6">
                <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="查看图片 / 下载网络图片" Command="{Binding OpenMediaCommand}"
                        Margin="8" Padding="8,5" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedProperties}"
                                  Grid.IsSharedSizeScope="True"
                                  Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PropertyName" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               Width="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource SixCharacterWidth}}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>

        <GridSplitter x:Name="UpperBottomSplitter" Grid.Row="2" Height="6"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#C8D3DC"
                      Cursor="SizeNS" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      ToolTip="按住并上下拖动，调整地图区与下方功能面板的大小；松开后自动记住布局。"
                      DragCompleted="OnPanelSplitterDragCompleted" />

        <TabControl x:Name="BottomTabs" Grid.Row="3" Margin="6,0,6,6" SelectionChanged="OnBottomTabSelectionChanged">
            <TabItem x:Name="GuideTab" Header="攻略数据">
                <local:GuideWorkbenchControl x:Name="GuideWorkbench" />
            </TabItem>
            <TabItem x:Name="PlanningTab" Header="路线规划" IsEnabled="{Binding IsRoutePlanningActive}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="{Binding RoutePlanningModeLabel}" FontWeight="Bold" Margin="0,0,18,0" />
                        <TextBlock Text="{Binding CurrentRouteLegModeLabel}" Margin="0,0,14,0" />
                        <Button Content="下一段：BRouter" Command="{Binding NextBRouterLegCommand}" Margin="0,0,5,0" />
                        <Button Content="下一段：手绘" Command="{Binding NextManualLegCommand}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="撤销最后一个点" Command="{Binding UndoPlanningPointCommand}" Margin="0,0,5,0" />
                        <Button Content="重做" Command="{Binding RedoPlanningPointCommand}" Margin="0,0,5,0" />
                        <Button Content="清空规划" Command="{Binding ClearPlanningCommand}" Margin="0,0,5,0" />
                        <Button Content="完成规划" Command="{Binding CompletePlanningCommand}" Margin="0,0,5,0" />
                        <Button Content="取消规划" Command="{Binding CancelPlanningCommand}" />
                        <TextBlock Text="{Binding RoutePlanningStatus}" Margin="15,4,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding RoutePlanningPoints}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="顺序" Binding="{Binding Order}" Width="65" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" />
                            <DataGridTextColumn Header="纬度" Binding="{Binding Latitude}" Width="130" />
                            <DataGridTextColumn Header="经度" Binding="{Binding Longitude}" Width="130" />
                            <DataGridTextColumn Header="下一段方式" Binding="{Binding NextLegMode}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="AnalysisTab" Header="数据分析">
                <local:ElevationAnalysisControl x:Name="ElevationAnalysis" />
            </TabItem>
            <TabItem x:Name="FavoritesTab" Header="收藏点"><local:FavoritesPanel x:Name="FavoritesContent" /></TabItem>
        </TabControl>

        <StatusBar x:Name="MainStatusBar" Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding Map.MouseCoordinateText}" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding CurrentSelectedTrackStatus}" ToolTip="{Binding CurrentSelectedTrackDisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="400" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding Map.ZoomText}" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding Map.MapStatusText}" /></StatusBarItem>
        </StatusBar>

        <Border Grid.RowSpan="4"
                Background="#88000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360"
                    Padding="24"
                    Background="White"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{Binding ProgressMessage}"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="6"
                                 Margin="0,18,0,18"
                                 IsIndeterminate="True" />
                    <Button Content="取消"
                            Width="90"
                            HorizontalAlignment="Center"
                            Command="{Binding CancelOperationCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

