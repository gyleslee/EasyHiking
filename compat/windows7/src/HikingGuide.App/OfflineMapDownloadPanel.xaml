<UserControl x:Class="HikingGuide.App.OfflineMapDownloadPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
  <TextBlock Text="下载在线图源为PMTiles离线地图" FontSize="16" FontWeight="Bold"/>
  <WrapPanel Margin="0,8"><TextBlock Text="地图名称：" VerticalAlignment="Center"/><TextBox x:Name="MapNameBox" Width="180" MaxLength="120" Text="离线地图" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
   <TextBlock Text="来源图源：" VerticalAlignment="Center"/><ComboBox x:Name="SourceBox" Width="250" DisplayMemberPath="Name" SelectionChanged="OnSourceChanged"/></WrapPanel>
  <TextBlock Text="OpenStreetMap 官方图源仅供在线浏览，不提供区域离线下载。" Margin="0,0,0,4" TextWrapping="Wrap"/>
  <WrapPanel Margin="0,4"><Button x:Name="SelectRegionButton" Content="地图多边形选区" Padding="10,5" Click="OnSelectRegion"/><Button Content="清除范围" Margin="8,0" Padding="10,5" Click="OnClearRegion"/>
   <TextBlock x:Name="RegionInfo" Text="尚未选择下载范围" VerticalAlignment="Center"/></WrapPanel>
  <WrapPanel Margin="0,6"><TextBlock Text="最小XYZ层级：" VerticalAlignment="Center"/><ComboBox x:Name="MinZoomBox" ToolTip="对应图源网址中的z值。低于最小或高于最大离线层级时，按原图源在线加载。" Width="60" SelectionChanged="OnRangeChanged" Margin="0,0,12,0"/>
   <TextBlock Text="最大XYZ层级：" VerticalAlignment="Center"/><ComboBox x:Name="MaxZoomBox" ToolTip="下载的最高XYZ瓦片层级；继续放大到未下载层级时使用在线清晰瓦片。" Width="60" SelectionChanged="OnRangeChanged" Margin="0,0,12,0"/>
   <TextBlock Text="并发：" VerticalAlignment="Center"/><ComboBox x:Name="ConcurrencyBox" Width="50" Margin="0,0,12,0"/>
   <TextBlock Text="请求间隔：" VerticalAlignment="Center"/><TextBox x:Name="IntervalBox" Text="200" Width="55" VerticalContentAlignment="Center"/><TextBlock Text=" 毫秒" VerticalAlignment="Center" Margin="0,0,14,0"/>
   <Button x:Name="EstimateButton" Content="预估大小" Click="OnEstimate" Padding="10,4"/><Button x:Name="StartButton" Content="开始下载" IsEnabled="False" Click="OnStart" Margin="8,0" Padding="10,4"/></WrapPanel>
  <TextBlock x:Name="EstimateInfo" TextWrapping="Wrap" Margin="0,4" Text="选择图源、多边形范围和层级后，可预估瓦片数量及文件大小。"/>
  <Expander x:Name="TasksExpander" Header="下载任务（0）—关闭软件后可续传" IsExpanded="False" Margin="0,10,0,4"><StackPanel>
  <WrapPanel Margin="0,0,0,5"><Button Content="暂停当前任务" Click="OnPause" Padding="8,3"/><Button Content="续传 / 重试" Click="OnResume" Margin="6,0" Padding="8,3"/><Button Content="保存已下载部分" Click="OnSavePartial" Padding="8,3"/><Button Content="删除任务" Click="OnDeleteTask" Margin="6,0" Padding="8,3"/></WrapPanel>
  <DataGrid x:Name="TasksGrid" Height="100" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns>
   <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="图源" Binding="{Binding SourceName}" Width="140"/><DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="85"/><DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="230"/><DataGridTextColumn Header="已下载大小" Binding="{Binding SizeText}" Width="90"/><DataGridTextColumn Header="提示" Binding="{Binding Message}" Width="*" MinWidth="180"/>
  </DataGrid.Columns></DataGrid></StackPanel></Expander>
  <TextBlock Text="已下载离线地图" FontWeight="Bold" Margin="0,12,0,4"/>
  <WrapPanel Margin="0,0,0,6"><Button Content="定位中心" Click="OnLocate" Padding="8,3"/><Button Content="启用 / 停用" Click="OnToggle" Margin="6,0" Padding="8,3"/><Button Content="打开所在文件夹" Click="OnOpenFolder" Padding="8,3"/><Button Content="删除离线地图" Click="OnDeletePack" Margin="6,0" Padding="8,3"/><Button Content="刷新列表" Click="OnRefresh" Padding="8,3"/></WrapPanel>
  <DataGrid x:Name="PacksGrid" Height="155" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns>
   <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="45"/><DataGridTextColumn Header="地图名称" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="来源图源" Binding="{Binding SourceName}" Width="160"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/><DataGridTextColumn Header="下载日期" Binding="{Binding DateText}" Width="130"/><DataGridTextColumn Header="层级" Binding="{Binding ZoomText}" Width="80"/><DataGridTextColumn Header="瓦片数" Binding="{Binding TileCount,StringFormat=N0}" Width="85"/><DataGridTextColumn Header="完整度" Binding="{Binding CompletenessText}" Width="140"/>
  </DataGrid.Columns></DataGrid>
  <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8"/>
 </StackPanel></ScrollViewer>
</UserControl>


