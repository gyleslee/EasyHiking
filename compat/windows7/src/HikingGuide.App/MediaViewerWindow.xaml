<Window x:Class="HikingGuide.App.MediaViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片查看" Width="1000" Height="730" MinWidth="600" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="#20252a">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="10">
            <Button Content="上一张" Click="PreviousClicked" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="下一张" Click="NextClicked" Padding="10,5" Margin="0,0,14,0" />
            <Button Content="放大" Click="ZoomInClicked" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="缩小" Click="ZoomOutClicked" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="适应窗口" Click="FitClicked" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="100%" Click="ActualClicked" Padding="10,5" Margin="0,0,14,0" />
            <Button x:Name="DownloadButton" Content="下载并查看" Click="DownloadClicked" Padding="10,5" Margin="0,0,6,0" />
            <Button x:Name="RefreshButton" Content="重新下载" Click="RefreshClicked" Padding="10,5" Margin="0,0,6,0" />
            <Button x:Name="CancelDownloadButton" Content="取消下载" Click="CancelDownloadClicked" Padding="10,5" Margin="0,0,6,0" Visibility="Collapsed" />
            <Button x:Name="SaveButton" Content="保存到项目" Click="SaveClicked" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="关闭" Click="CloseClicked" Padding="10,5" />
        </WrapPanel>
        <TextBlock x:Name="StatusLabel" DockPanel.Dock="Bottom" Foreground="White" Margin="10,5,10,10" TextWrapping="Wrap" />
        <Border x:Name="Viewport" ClipToBounds="True" Background="#101318"
                MouseWheel="ViewportMouseWheel" MouseLeftButtonDown="ViewportMouseDown"
                MouseLeftButtonUp="ViewportMouseUp" MouseMove="ViewportMouseMove"
                SizeChanged="ViewportSizeChanged">
            <Canvas>
                <Image x:Name="Photo" RenderOptions.BitmapScalingMode="HighQuality" />
            </Canvas>
        </Border>
    </DockPanel>
</Window>
